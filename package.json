{
  "name": "@immunity-protocol/sdk",
  "version": "0.6.10",
  "description": "Immunity SDK: decentralized threat intelligence for AI agents on 0G Chain.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ophelios-studio/immunity-sdk.git"
  },
  "homepage": "https://github.com/ophelios-studio/immunity-sdk#readme",
  "bugs": {
    "url": "https://github.com/ophelios-studio/immunity-sdk/issues"
  },
  "keywords": [
    "immunity",
    "threat-intelligence",
    "ai-agents",
    "0g",
    "axl",
    "gensyn",
    "antibody",
    "tee",
    "ethers"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "abi",
    "infra/axl-mesh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "1.2.2",
    "@0glabs/0g-serving-broker": "0.7.5",
    "axl-pubsub": "^0.1.1",
    "ethers": "^6.14.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^17.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
